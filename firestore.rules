rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===== 共通ヘルパー =====
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.uid in [
        "Ay6VCS8HTgM3RqjDYZ0wKdHrSKz1",
        "GvVhAmT56GZjsWrl1YRaStB81im1"
      ];
    }
    function isNotSuspended() {
      return isSignedIn() && !exists(/databases/$(database)/documents/suspensions/$(request.auth.uid));
    }
    function isDeviceLinked() {
      return isSignedIn() && (
        isAdmin() ||
        !("deviceId" in request.resource.data) ||
        !exists(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)) ||
        get(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)).data.uid == request.auth.uid
      );
    }
    function isTradeParticipant(tradeId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/trades/$(tradeId))
        && request.auth.uid in get(/databases/$(database)/documents/trades/$(tradeId)).data.get("participants", []);
    }
    // 通知配列の先頭1件追加のみ（本文200文字まで）
    function isOnePrependOnly() {
      let before = resource.data.get("notifications", []);
      let after = request.resource.data.get("notifications", []);
      let first = after[0];
      return after.size() == before.size() + 1
        && first.keys().hasAll(["id", "text", "type", "read", "createdAt"])
        && first.text is string
        && first.text.size() <= 200
        && first.read == false
        && after[1:] == before;
    }

    // ===== users =====
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid && isNotSuspended();
      allow update: if isAdmin()
        // カードウォッチ等：他ユーザーからの通知1件先頭追加（本文200文字まで）
        || (isNotSuspended()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["notifications"])
          && isOnePrependOnly())
        // 本人の公開プロフィール等（評価集計は改ざん不可）
        || (isSignedIn() && request.auth.uid == uid && isNotSuspended()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["ratingSum", "ratingCount"]));
      allow delete: if isAdmin();

      match /tokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
        allow read: if isAdmin();
      }
      match /notifications/{notifId} {
        allow read, update: if isSignedIn() && request.auth.uid == uid;
        allow create: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
        allow delete: if isSignedIn() && (isAdmin() || request.auth.uid == uid);
      }
      // 配送先などの非公開個人情報
      match /private/{docId} {
        allow read, write: if isSignedIn() && (isAdmin() || request.auth.uid == uid);
      }
    }

    // ===== posts =====
    match /posts/{postId} {
      allow read: if true;
      allow create: if isNotSuspended() && isDeviceLinked()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (
          // 投稿者本人：いいね数・参加人数は改ざん不可
          isNotSuspended()
          && resource.data.userId == request.auth.uid
          && request.resource.data.get("likesCount", 0) == resource.data.get("likesCount", 0)
          && request.resource.data.get("joinsCount", 0) == resource.data.get("joinsCount", 0)
        )
        || (
          // いいね数の増減など（サブコレクション連動）はクライアントの専用パスで扱う
          isNotSuspended()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likesCount", "viewsCount", "joinsCount", "status", "price", "updatedAt", "editedAt"])
        );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      match /photos/{photoId} {
        allow read: if true;
        allow write: if isNotSuspended() && (
          isAdmin() || get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid
        );
      }
      match /likes/{likeUid} {
        allow read: if true;
        allow create, delete: if isNotSuspended() && request.auth.uid == likeUid;
      }
      match /joins/{joinUid} {
        allow read: if true;
        allow create: if isNotSuspended() && request.auth.uid == joinUid;
        allow delete: if isAdmin()
          || (isSignedIn() && request.auth.uid == joinUid)
          || (isSignedIn() && get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid);
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isNotSuspended() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
      match /offers/{offerId} {
        allow read: if isSignedIn();
        allow create: if isNotSuspended() && request.resource.data.userId == request.auth.uid;
        allow update: if isNotSuspended() && (
          isAdmin()
          || resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid
        );
      }
      match /photoHistory/{histId} {
        allow read: if isSignedIn();
        allow write: if isNotSuspended() && (
          isAdmin() || get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid
        );
      }
    }

    // ===== trades =====
    match /trades/{tradeId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.get("participants", []));
      allow create: if isNotSuspended()
        && request.auth.uid in request.resource.data.get("participants", []);
      allow update: if isAdmin()
        || (isNotSuspended() && request.auth.uid in resource.data.get("participants", []));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isTradeParticipant(tradeId);
        allow create: if isNotSuspended() && isTradeParticipant(tradeId)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      // 取引当事者のみが読める配送先共有
      match /shipping/{userId} {
        allow read: if isAdmin() || isTradeParticipant(tradeId);
        allow create, update: if isNotSuspended()
          && request.auth.uid == userId
          && isTradeParticipant(tradeId);
        allow delete: if isAdmin() || isTradeParticipant(tradeId);
      }
    }

    // ===== その他コレクション（既存挙動を維持） =====
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isNotSuspended() && request.resource.data.fromId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isNotSuspended() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /inquiries/{inquiryId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isNotSuspended() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /suspensions/{uid} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == uid);
      allow write: if isAdmin();
    }
    match /devices/{deviceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /deviceBans/{deviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cardWatchers/{cardId}/users/{uid} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
    match /cardCatalog/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cardPhotos/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cardPhotosClean/{cardId} {
      allow read, write: if isAdmin();
    }
    match /auto_go_pools/{poolId} {
      allow read: if true;
      allow write: if isAdmin();
      match /entries/{entryUid} {
        // 自分のエントリーのみ読取可（管理者は全員）
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == entryUid);
        allow write: if false; // Cloud Functions のみ
      }
    }
    match /auto_go_shipping_hashes/{hashId} {
      allow read, write: if false;
    }
  }
}
